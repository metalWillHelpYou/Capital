rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый пользователь читает и пишет только свой собственный документ —
    // users/{его uid}. Даже если кто-то узнает apiKey из кода (это нормально,
    // он не секретный), без входа под этим аккаунтом чужие данные недоступны.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Всё остальное — запрещено по умолчанию.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
